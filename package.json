{
  "name": "labline",
  "version": "0.1.0",
  "private": true,
  "description": "A real-time queue for college lab assistance and doubt-solving",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"gray,cyan\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "promote-mentor": "npm run promote-mentor --workspace=server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
