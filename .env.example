# LabLine Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.

# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin (CORS & Socket.IO allowed origin)
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB)
# Provide a valid MongoDB connection string (e.g., mongodb://localhost:27017/labline)
MONGODB_URI=mongodb://localhost:27017/labline

# Session / JWT Secret (minimum 32 characters for HMAC SHA-256)
JWT_SECRET=replace-with-a-secure-random-jwt-secret-at-least-32-chars
